# Lintian overrides for the source package.
# Add entries here if lintian flags something legitimate that we want
# to acknowledge rather than fix. Each entry must include a comment
# explaining why the override is justified.

# Every PPA upload carries Launchpad's per-series suffix, ~ubuntuXX.YY.N
# (make deb-ppa, PPA_TABLE). lintian reads a Debian revision with three
# dot-separated parts as an old-style binary NMU unless it finds a fourth
# part, so it flags 2.0.0-1~ubuntu24.04.1; zark never makes binary NMUs.
zark source: binary-nmu-debian-revision-in-source
