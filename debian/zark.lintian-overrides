# Lintian overrides for the zark binary package.
#
# Add entries here if lintian flags something legitimate that we want
# to acknowledge rather than fix. Each entry must include a comment
# explaining why the override is justified.

# zark is hosted on GitHub, not the Debian BTS — there are no Debian
# bugs for the initial upload to close. Removing this warning would
# require either filing a synthetic Debian bug or migrating issue
# tracking, neither of which makes sense for a Launchpad PPA.
zark: initial-upload-closes-no-bugs

# A manpage is a planned improvement — not blocking the first PPA
# release. Once written, it will install via debian/zark.manpages and
# this override can be removed.
zark: no-manual-page [usr/bin/zark]
