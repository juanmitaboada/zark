#!/bin/sh
# zark prerm - on removal, remove what `zark setup` installed besides
# sanoid's configuration: the status alerts (MOTD script, zark-status.timer
# and its service), the APT guard (hook, its apt.conf and MOTD reminder) and
# the update-grub guard. It runs before dpkg deletes zark's files, so zark
# itself does it. Not on upgrade: the new version keeps them.

set -e

case "$1" in
    remove)
        if [ -x /usr/share/zark/zark ]; then
            # A file that is not zark's is left and named; removal goes on.
            /usr/share/zark/zark setup --remove || echo "zark: see the files left above" >&2
        fi
        ;;
    upgrade|deconfigure|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
